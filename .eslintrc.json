{
  "root": true,
  "extends": [
    "next/core-web-vitals"
  ],
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error",
          "debug",
          "info"
        ]
      }
    ],
    "eqeqeq": [
      "warn",
      "smart"
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "@typescript-eslint/consistent-type-assertions": [
      "warn",
      {
        "assertionStyle": "as",
        "objectLiteralTypeAssertions": "allow-as-parameter"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/**/*.mjs",
        "*.mjs",
        "*.cjs"
      ],
      "env": {
        "node": true,
        "es2022": true
      },
      "parserOptions": {
        "sourceType": "module",
        "ecmaVersion": 2022
      },
      "rules": {
        "no-console": "off",
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "src/__tests__/**/*",
        "src/test-utils/**/*",
        "vitest.setup.ts",
        "vitest.config.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "no-console": "off",
        "no-script-url": "off"
      }
    }
  ]
}
