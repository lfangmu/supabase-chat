# Supabase 配置（密钥获取：Project Settings → API Keys）
#   Publishable key（sb_publishable_…，公开、可进浏览器）
#   Secret key（sb_secret_…，特权、仅服务端、保密）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_publishable_key
# Secret key（仅服务端使用，用于生成签名 URL 和管理操作，切勿加 NEXT_PUBLIC_ 前缀）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# 聊天密码配置（仅服务端使用，不要加 NEXT_PUBLIC_ 前缀）
CHAT_PASSWORD=your_password_here

# 聊天门禁开关（可选，默认开启）：
#   设为 false 时关闭普通聊天鉴权，任何人无需密码即可直接进入聊天。
#   仅影响普通聊天；管理后台 /admin 始终要求密码，不受此开关影响。
CHAT_AUTH_ENABLED=true

# 管理后台密码（可选）：用于登录管理后台 /admin，登录后可查看全部房间与消息，并删除群聊（仅管理员）。
# 与普通聊天密码物理隔离（独立的 admin_session 会话）。
# 支持以下任一变量名，代码按顺序取第一个非空值生效：
#   ADMIN_PASSWORD（推荐，部署到 Cloudflare Pages 时注入最稳定）
#   SUPER_PASSWORD / CHAT_SUPER_PASSWORD（备选）
# 全为空则无法登录管理后台。
# 注意：在 Cloudflare Pages 上新增环境变量后，必须「触发全新构建」（推送新提交或控制台 Deploy，
#       不要只点 Retry），否则新变量不会进入运行时。
ADMIN_PASSWORD=your_admin_password_here

# JWT 密钥（用于签名 httpOnly cookie，请设置一个随机字符串）
CHAT_JWT_SECRET=your_random_secret_at_least_32_chars_long

# 密码版本盐值（可选，增加安全性）
CHAT_VERSION_SALT=your_optional_salt

# ImgBB 配置（可选，通过服务端代理上传，不再暴露到前端）
# 获取 API Key: https://imgbb.com/accounts/settings
IMGBB_API_KEY=your_imgbb_api_key

# 禁用 Next.js 版本检查（解决网络连接问题）
NEXT_DISABLE_VERSION_CHECK=1

# Web Push VAPID 密钥对（通过 npx web-push generate-vapid-keys 生成）
# 公钥需要前端访问，加 NEXT_PUBLIC_ 前缀
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# 私钥仅服务端使用
VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID subject（mailto 或 https URL）
VAPID_SUBJECT=mailto:your@email.com
