# Supabase 配置（密钥获取：Project Settings → API Keys）
#   Publishable key（sb_publishable_…，公开、可进浏览器）
#   Secret key（sb_secret_…，特权、仅服务端、保密）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_publishable_key
# 浏览器专用：Supabase 反向代理域名（Cloudflare Worker）。auth REST 与 Realtime WebSocket 走它，
# 由 Worker 转发到真实项目，绕过国内对 *.supabase.co 的拦截。与服务端直连的 NEXT_PUBLIC_SUPABASE_URL 解耦。
# 例如 https://supabase.your-domain.com（部署 supabase-proxy 后填写，prod+preview 都要设）。
# 可选：若留空，浏览器端会回退直连 NEXT_PUBLIC_SUPABASE_URL（真实项目地址）——仅当你本地网络能直连
# *.supabase.co 时适用（本地 dev 免代理调试）；生产/中国大陆用户必须配此变量，否则被墙阻断。
NEXT_PUBLIC_SUPABASE_PROXY_URL=your_supabase_proxy_url
# Secret key（仅服务端使用，用于生成签名 URL 和管理操作，切勿加 NEXT_PUBLIC_ 前缀）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# ============================================================
# 鉴权：Supabase Auth（已移除自建 JWT / 密码体系）
# ------------------------------------------------------------
# 不再需要 CHAT_JWT_SECRET / SUPABASE_JWT_SECRET / CHAT_PASSWORD /
# ADMIN_PASSWORD —— 身份由 Supabase Auth 管理，会话 cookie 由 @supabase/ssr 维护。
#
# 需要在 Supabase 后台开启（Authentication → Sign In / Providers）：
#   1. Email：用于邮箱注册/登录
#   2. Anonymous sign-ins：保留「不用注册直接聊」的体验
# 管理员 = Supabase Auth 用户 + public.users.role = 'admin'（不再有独立后台密码）。
# ============================================================

# ImgBB 配置（可选，通过服务端代理上传，不再暴露到前端）
# 获取 API Key: https://imgbb.com/accounts/settings
IMGBB_API_KEY=your_imgbb_api_key

# 禁用 Next.js 版本检查（解决网络连接问题）
NEXT_DISABLE_VERSION_CHECK=1

# Web Push VAPID 密钥对（通过 npx web-push generate-vapid-keys 生成）
# 公钥需要前端访问，加 NEXT_PUBLIC_ 前缀
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# 私钥仅服务端使用
VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID subject（mailto 或 https URL）
VAPID_SUBJECT=mailto:your@email.com
