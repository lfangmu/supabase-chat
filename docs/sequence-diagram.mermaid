%% Supabase Chat 12 Features — Sequence Diagrams
%% Generated from ARCHITECTURE-12-features.md

%% ============================================
%% 1. Emoji Reaction Toggle 流程
%% ============================================

sequenceDiagram
    participant User as 用户
    participant RB as ReactionsBar
    participant UR as useReactions
    participant API as POST /api/reactions
    participant DB as Supabase DB
    participant RT as Realtime Channel
    participant Other as 其他客户端

    User->>RB: 点击 emoji 回应
    RB->>UR: toggleReaction(messageId, emoji)
    UR->>UR: 乐观更新本地 reactionsMap
    UR->>API: POST { message_id, user, emoji }
    API->>DB: SELECT WHERE message_id AND user AND emoji
    alt 记录不存在
        DB-->>API: 无记录
        API->>DB: INSERT INTO reactions
        DB-->>API: 插入成功
        API-->>UR: { success: true, action: 'added' }
        UR->>RT: broadcast 'reaction-toggle'
        Note right of UR: payload: { message_id, user, emoji, action: 'add' }
    else 记录已存在
        DB-->>API: 找到记录
        API->>DB: DELETE FROM reactions
        DB-->>API: 删除成功
        API-->>UR: { success: true, action: 'removed' }
        UR->>RT: broadcast 'reaction-toggle'
        Note right of UR: payload: { message_id, user, emoji, action: 'remove' }
    end
    RT-->>Other: 'reaction-toggle' event
    Other->>Other: 更新本地 reactionsMap
    Other->>Other: ReactionsBar 重新渲染

%% ============================================
%% 2. 链接预览抓取流程
%% ============================================

sequenceDiagram
    participant MI as MessageItem
    participant ULP as useLinkPreview
    participant Cache as LRU Cache (内存)
    participant API as POST /api/link-preview
    participant Guard as SSRF Guard
    participant Target as 目标 URL
    participant DB as Supabase DB

    MI->>ULP: onMessageRender(message)
    ULP->>ULP: 正则检测 URL in content
    alt 无 URL
        ULP-->>MI: 不显示预览
    else 检测到 URL
        ULP->>Cache: get(url)
        alt 缓存命中 && 未过期 (< 5min)
            Cache-->>ULP: 返回缓存结果
            ULP-->>MI: 显示预览卡片
        else 缓存未命中或已过期
            ULP->>API: POST { url, message_id }
            API->>Guard: isUrlSafe(url)
            alt SSRF 检测失败 (内网IP/非http协议)
                Guard-->>API: false (拒绝)
                API-->>ULP: { success: false }
                ULP-->>MI: 静默不显示预览
            else SSRF 检测通过
                Guard-->>API: true (允许)
                API->>Target: fetch(url, { signal: AbortSignal.timeout(5000), headers: { 'User-Agent': '...' } })
                alt 超时或网络错误
                    Target-->>API: 超时/错误
                    API-->>ULP: { success: false }
                    ULP-->>MI: 静默不显示预览
                else 成功获取 HTML
                    Target-->>API: HTML 响应 (< 1MB)
                    API->>API: 正则解析 og:title / og:description / og:image
                    opt message_id 存在
                        API->>DB: UPDATE messages SET link_preview = { url, title, description, image, fetched_at }
                    end
                    API-->>ULP: { success: true, preview: { title, description, image } }
                    ULP->>Cache: set(url, preview) — LRU 淘汰最旧
                    ULP-->>MI: 显示预览卡片 (收起态)
                end
            end
        end
    end

%% ============================================
%% 3. 全局搜索流程
%% ============================================

sequenceDiagram
    participant User as 用户
    participant SM as SearchModal
    participant UGS as useGlobalSearch
    participant API as GET /api/messages
    participant DB as Supabase DB

    User->>SM: 输入关键词
    SM->>UGS: setKeyword(keyword)
    UGS->>UGS: 300ms 防抖等待
    User->>SM: 设置过滤器 (发送人/类型/日期)
    SM->>UGS: setFilters(filters)
    UGS->>UGS: 防抖结束后触发搜索
    UGS->>API: GET /api/messages?global=true&q=keyword&sender=...&type=...&startDate=...&endDate=...
    API->>API: 验证参数
    API->>DB: SELECT m.*, r.name as room_name FROM messages m LEFT JOIN rooms r ON m.room_id = r.id WHERE content ILIKE '%keyword%' AND (type = ?) AND ("user" ILIKE '%sender%') AND (timestamp >= startDate) AND (timestamp <= endDate) AND (r.type != 'dm' OR r.type IS NULL) ORDER BY timestamp DESC LIMIT 100
    DB-->>API: 匹配消息列表 (最多100条)
    API-->>UGS: { success: true, messages: [...] }
    UGS->>UGS: 存储搜索结果到 state
    UGS-->>SM: 渲染结果列表 (内容摘要高亮 + 发送人 + 房间名 + 时间)

    User->>SM: 点击某条搜索结果
    SM->>UGS: onResultClick(message)
    UGS->>UGS: 调用 onJumpToMessage(message.room_id, message.id)
    UGS->>UGS: 触发 switchRoom(message.room_id)
    Note over UGS: 房间切换完成后
    UGS->>UGS: 设置 scrollToMessageId = message.id
    UGS-->>SM: 关闭搜索面板
    Note over UGS: MessageList 检测到 scrollToMessageId 变化 → 滚动到目标消息 → 高亮3s

%% ============================================
%% 4. 1:1 DM 发起流程
%% ============================================

sequenceDiagram
    participant UserA as 用户A
    participant RS as RoomSidebar
    participant UDM as useDM
    participant API as POST /api/rooms
    participant DB as Supabase DB
    participant RT as Realtime Channel
    participant UserB as 用户B 客户端

    UserA->>RS: 点击在线用户B头像 → "发起私聊"
    RS->>UDM: startDM(userA, userB)
    UDM->>UDM: 生成 DM roomId
    Note right of UDM: dmRoomId = 'dm:' + [userA.trim(), userB.trim()].sort((a,b) => a.localeCompare(b)).join(':')
    UDM->>API: POST /api/rooms { type: 'dm', id: dmRoomId, name: userB, created_by: userA, participants: [userA, userB] }
    API->>DB: INSERT INTO rooms (id, name, type, created_by, created_at) VALUES (dmRoomId, userB, 'dm', userA, NOW()) ON CONFLICT (id) DO NOTHING
    DB-->>API: 成功 (新建或已存在)
    API-->>UDM: { success: true, room: { id: dmRoomId, ... } }
    UDM->>UDM: 刷新 DM 列表 (loadDMs)
    UDM->>UDM: switchRoom(dmRoomId)
    UDM-->>RS: 切换到 DM 房间
    Note over UserA: 用户A进入DM房间, 可发送消息

    Note over UserB: 用户B也在同一 DM 房间中
    UserB->>RT: 进入房间 chat-room:{dmRoomId}
    Note over UserB: 通过 GET /api/dm-list 发现自己参与的 DM
    UserB->>RT: 订阅消息
    UserA->>RT: broadcast 'chat-message'
    RT-->>UserB: 接收消息

%% ============================================
%% 5. Web Push 推送流程
%% ============================================

sequenceDiagram
    participant User as 用户
    participant Client as 浏览器页面
    participant SW as Service Worker
    participant SubAPI as /api/push/subscribe
    participant DB as Supabase DB
    participant MsgAPI as POST /api/messages
    participant SendAPI as /api/push/send (Node.js)
    participant WebPush as web-push 库
    participant FCM as Push Service (FCM/APNs)

    rect rgb(240, 248, 255)
    Note over User,DB: 阶段1: 订阅推送
    User->>Client: 开启推送通知
    Client->>Client: 检查 Notification.permission
    alt 未授权
        Client->>User: 请求 Notification 权限
        User-->>Client: 授权
    end
    Client->>SW: pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: VAPID_PUBLIC_KEY })
    SW-->>Client: PushSubscription { endpoint, keys: { p256dh, auth } }
    Client->>SubAPI: POST { user, endpoint, keys: { p256dh, auth } }
    SubAPI->>DB: INSERT INTO push_subscriptions (id, user, endpoint, p256dh, auth) VALUES (...) ON CONFLICT DO NOTHING
    DB-->>SubAPI: 成功
    SubAPI-->>Client: { success: true }
    end

    rect rgb(255, 245, 238)
    Note over MsgAPI,FCM: 阶段2: 推送触发 (用户离线时)
    Note over MsgAPI: 其他用户发送包含 @user 的消息
    MsgAPI->>MsgAPI: 检测 @user in message.content
    MsgAPI->>DB: INSERT INTO messages (...)
    MsgAPI->>DB: SELECT * FROM push_subscriptions WHERE user = @mentionedUser
    DB-->>MsgAPI: 订阅列表
    MsgAPI->>SendAPI: POST { user, title: roomName, body: sender + content, url: '/?room=' + roomId }
    Note over SendAPI: runtime = 'nodejs'
    SendAPI->>WebPush: webpush.sendNotification(subscription, JSON.stringify(payload), { vapidDetails })
    WebPush->>FCM: HTTP POST 推送消息
    FCM-->>SW: push event (用户浏览器收到)
    SW->>SW: self.registration.showNotification(title, { body, icon, badge, data: { url }, tag: 'chat-push' })
    Note over User: 用户看到系统通知 (即使浏览器最小化)
    end

    rect rgb(240, 255, 240)
    Note over User,SW: 阶段3: 点击通知跳转
    User->>SW: 点击通知
    SW->>SW: notificationclick event → event.notification.close()
    SW->>SW: clients.openWindow(notification.data.url || '/')
    SW-->>Client: 打开/聚焦应用窗口
    Client->>Client: 路由到 /?room=roomId
    Note over User: 用户进入对应房间
    end
